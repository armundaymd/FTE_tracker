# Copy this file to .env and fill in real values. Never commit .env.

# ── Database ───────────────────────────────────────────────────────────────
# asyncpg DSN — use postgresql+asyncpg:// (NOT postgresql://)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ed_capacity

# ── Security ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_before_deploying

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

# ── QGenda (Phase 2) ────────────────────────────────────────────────────────
# QGENDA_BASE_URL=https://api.qgenda.com/v2
# QGENDA_COMPANY_KEY=your_company_key_here
# QGENDA_API_KEY=your_api_key_here
