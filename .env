# ── Copy this file to .env and fill in real values. Never commit .env. ────────

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# Used by the postgres service and interpolated into DATABASE_URL below.
POSTGRES_PASSWORD=sinai_password

# ── FastAPI backend ────────────────────────────────────────────────────────────
# When running via docker-compose, docker-compose.yml overrides DATABASE_URL so
# the hostname is always "postgres" (the service name), ignoring this value.
# For local development outside Docker, change "postgres" to "localhost".
DATABASE_URL=postgresql+asyncpg://postgres:sinai_password@localhost:5432/ed_capacity

# Generate a real key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=46d5ebed4b63ba44bd7c2f59c00b47a6f6eff8231c72ef9031b44f739318f144

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173
