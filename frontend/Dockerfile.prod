# frontend/Dockerfile.prod
# Place this file in the frontend/ folder alongside the existing Dockerfile.
# The existing Dockerfile stays as-is for local dev (docker compose up).
# This one is used only by docker-compose.prod.yml on the server.

# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --prefer-offline
COPY . .
RUN npm run build
# Vite outputs static files to /app/dist

# ---- serve stage ----
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
